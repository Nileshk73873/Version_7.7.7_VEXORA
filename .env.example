# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (use ONE of the two options below) ──────────

# OPTION 1: Single connection URL (recommended for production / Render)
DATABASE_URL=postgresql://postgres:1234@localhost:5432/vulnora

# OPTION 2: Individual values (local dev fallback, used only if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=vulnora
# DB_USER=postgres
# DB_PASSWORD=1234

# ─── Google Gemini AI ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Available models: gemini-2.0-flash | gemini-1.5-flash | gemini-1.5-pro | gemini-2.5-pro-preview
GEMINI_MODEL=gemini-2.0-flash

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=10

# ─── Scanner Settings ─────────────────────────────────────
SCAN_TIMEOUT_MS=30000
